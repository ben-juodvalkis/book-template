# book.config — per-book settings read by the build (scripts/_build.py load_config).
#
# Format: one `key = value` per line. Blank lines and `#` comments are ignored.
# This file is OPTIONAL — delete it and every key falls back to its default.

# ── front_matter_pages ──────────────────────────────────────────────────────
# Number of leading physical pages that carry NO printed folio (front matter:
# the opening page, a blank, a title page, contents, etc.). Arabic page numbers
# restart at 1 on the FIRST body page after them.
#
#   0  → number every page from 1 (simple book, the default).
#   N  → first N pages unnumbered; body page N+1 prints folio "1".
#
# This ONLY shifts the displayed folio. You must ALSO:
#   1. put `.no-number` on the `.page-number` span of each front-matter page, and
#   2. count the pages correctly: e.g. opening page (1) + blank (1) + title (1) +
#      contents (2) = front_matter_pages = 5.
# See CLAUDE.md "Front matter & page numbering" for the full recipe.
#
# The shipped opening spread (src/spreads/01-title.html) is LOGO + BLANK + TITLE
# = 3 unnumbered front-matter pages, so front_matter_pages starts at 3. Add any
# further front matter (e.g. a 2-page contents = +2 → 5) and bump this to match.
front_matter_pages = 3
