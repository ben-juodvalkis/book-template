# book.config — per-book settings read by the build (scripts/_build.py load_config).
#
# Format: one `key = value` per line. Blank lines and `#` comments are ignored.
# This file is OPTIONAL — delete it and every key falls back to its default.

# ── front_matter_pages ──────────────────────────────────────────────────────
# Number of leading physical pages that carry NO printed folio (front matter:
# the opening page, a blank, a title page, contents, etc.). Arabic page numbers
# restart at 1 on the FIRST body page after them.
#
#   0  → number every page from 1 (simple book, the default).
#   N  → first N pages unnumbered; body page N+1 prints folio "1".
#
# This ONLY shifts the displayed folio. You must ALSO:
#   1. put `.no-number` on the `.page-number` span of each front-matter page, and
#   2. count the pages correctly: e.g. opening page (1) + blank (1) + title (1) +
#      contents (2) = front_matter_pages = 5.
# See CLAUDE.md "Front matter & page numbering" for the full recipe.
#
# The shipped opening spread (src/spreads/01-title.html) is LOGO + BLANK + TITLE
# = 3 unnumbered front-matter pages, so front_matter_pages starts at 3. Add any
# further front matter (e.g. a 2-page contents = +2 → 5) and bump this to match.
front_matter_pages = 3

# ── Page geometry ────────────────────────────────────────────────────────────
# Trim size, bleed, and safe margins. This is the SINGLE SOURCE OF TRUTH for print
# geometry: the build injects these into every render as CSS variables that
# print.css, design.css, and scripts/spread-photo.py all read — so changing the
# size here re-flows the whole book (pages, bleed, safe zones, and cross-gutter
# photos) with no CSS or script edits.
#
# Pick a preset; override individual fields below only if your printer's spec
# differs. Verify against your printer's current spec sheet. Delete this whole
# section to use the blurb-8x10 default.
#
# Saddle-stitch photo books:  blurb-8x10 (default), blurb-7x7,
#                             blurb-10x8-landscape, us-letter
# Perfect-bound trade sizes:  trade-6x9, trade-5x8, trade-5.5x8.5, trade-8.5x11,
#                             square-8.5x8.5
# Service-named aliases:      kdp-6x9, ingramspark-6x9, lulu-6x9, kdp-5x8,
#                             kdp-5.5x8.5, lulu-5.5x8.5, kdp-8.5x11, kdp-square-8.5
#                             (KDP/IngramSpark/Lulu share standard trims; these
#                              resolve to the trade-* geometry above.)
page_size = blurb-8x10

# ── Binding ──────────────────────────────────────────────────────────────────
# "saddle-stitch" or "perfect-bound". Leave unset to inherit from the page_size
# preset (blurb-*/us-letter = saddle-stitch, trade-*/square = perfect-bound). This
# drives the page-count check and the cover/spine math (scripts/cover.py). Note:
# saddle-stitch imposes in MULTIPLES OF 4; perfect-bound only needs an even count,
# and its binding (gutter) safe margin should grow with page count — bump
# safe_binding above for thick books.
#   binding_type = perfect-bound

# Page count the build warns below. Unset = binding-aware default (saddle-stitch
# 20, perfect-bound 24). Set to match your printer's minimum.
#   min_pages = 32

# ── Cover / spine (perfect-bound) ────────────────────────────────────────────
# `./book cover --pages N` computes the spine as page_count / paper_ppi. Name a
# stock (PAPER_STOCKS: white, cream, standard-color, premium-color, blurb-standard)
# or give an explicit pages-per-inch. --stock/--ppi on the command line override these.
#   paper_stock = white
#   paper_ppi   = 444

# Optional per-field overrides — uncomment to use. Lengths accept 8, 8in, or 203mm;
# dpi is an integer. Anything left unset inherits from the preset above.
#   trim_width   = 8in      # trim (cut) width
#   trim_height  = 10in     # trim (cut) height
#   bleed        = 0.125in  # bleed on the outside/top/bottom edges (never the binding)
#   safe_binding = 0.5in    # keep-out from the fold (inner / gutter safe margin)
#   safe_outside = 0.5in    # keep-out from the outside edge
#   safe_top     = 0.25in   # keep-out from the top
#   safe_bottom  = 0.25in   # keep-out from the bottom
#   dpi          = 300      # target image resolution (spread-photo.py warns below this)
